# --- REQUIRED ---
# Google Sheet ID from the URL: https://docs.google.com/spreadsheets/d/[GOOGLE_SHEET_ID]/edit
GOOGLE_SHEET_ID=

# Service Account Email
GOOGLE_CLIENT_EMAIL=

# Private Key (Keep the quotes and use \n for newlines if pasting from JSON)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Commits by this email will be tracked
GITTRACK_AUTHOR_EMAIL=

# Comma-separated absolute paths to watch
# Example: /home/user/projects,/home/user/work
WATCH_DIRECTORIES=

# --- OPTIONAL ---
# Database file path (default: gittrack.db)
# DATABASE_PATH=gittrack.db

# Logging level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Name of the Google Sheet tab (default: Sheet1)
# GOOGLE_SHEET_NAME=Sheet1

# Interval between retries in milliseconds (default: 60000)
# RETRY_INTERVAL_MS=60000

# Maximum number of retries for a failed sync (default: 5)
# MAX_RETRY_COUNT=5
